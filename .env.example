# Это настройки сайта. start.bat / start.sh сами создают из этого файла файл .env
# Меняйте значения после знака "=" и перезапускайте сайт.

# 1 = режим разработки (на своём компьютере), 0 = боевой сервер
DJANGO_DEBUG=1

# Обязательно при DJANGO_DEBUG=0 (длинная случайная строка, никому не показывать):
# DJANGO_SECRET_KEY=
# Ваши домены через запятую (при DJANGO_DEBUG=0):
# DJANGO_ALLOWED_HOSTS=muzflowers.ru,www.muzflowers.ru
# DJANGO_CSRF_ORIGINS=https://muzflowers.ru
# DJANGO_TIME_ZONE=Europe/Moscow
# Адрес админки (по умолчанию /admin/). Лучше поменять на свой:
# DJANGO_ADMIN_URL=moya-sekretnaya-panel

# Контакты, которые видны на сайте:
SHOP_PHONE=+7 (000) 000-00-00
SHOP_EMAIL=hello@example.com
SHOP_ADDRESS=Ваш город, ул. Цветочная, 1
SHOP_HOURS=Ежедневно, 8:00–22:00

# Доставка: бесплатно от суммы и цена доставки (в рублях)
SHOP_FREE_DELIVERY_FROM=3000
SHOP_DELIVERY_COST=300
