# Настройки сайта MuzFlowers. start.bat сам создаёт из этого файла файл .env.
# Меняйте значения после знака "=" и перезапускайте сайт.
# Строки с решёткой (#) — подсказки; чтобы включить настройку, уберите решётку в начале строки.
#
# Телефон, график и доставка: /admin/ → «Настройки сайта». Адрес самовывоза: «Точки (магазины)».
# При первом запуске: Выхино, ул. Вешняковская, 39Г; +7 (995) 152-21-31; ежедневно 09:00–21:00.
# Заполненные .env и .env.production хранятся локально; в Git передаётся только этот образец.

# ───── На своём компьютере ничего менять не нужно ─────
# 1 = сайт на вашем компьютере, 0 = сайт в интернете (тогда обязательно заполните блок ниже)
DJANGO_DEBUG=1

# ───── Сайт в интернете (DJANGO_DEBUG=0) ─────
# Длинная случайная строка. Никому не показывайте.
# DJANGO_SECRET_KEY=
# Адрес вашего сайта (без http://), через запятую, если их несколько:
# DJANGO_ALLOWED_HOSTS=muzflowers.ru,www.muzflowers.ru
# DJANGO_CSRF_ORIGINS=https://muzflowers.ru
# Основной адрес сайта — для ссылок в письмах и поисковиках:
# SITE_URL=https://muzflowers.ru
# Если сайт стоит за nginx / хостингом, который сам включает HTTPS:
# DJANGO_BEHIND_PROXY=1
# Код для создания владельца на сайте в интернете (откройте /accounts/setup/?token=КОД):
# DJANGO_SETUP_TOKEN=
# Секретный адрес панели вместо /admin/ (лучше поменять):
# DJANGO_ADMIN_URL=panel-muz
# Куда складывать фотографии и локальную базу SQLite (на хостинге — отдельная постоянная папка):
# DJANGO_DATA_DIR=/data
# Внешняя PostgreSQL. Для compose.yaml заполнять не нужно: адрес собирается автоматически.
# DJANGO_DB_URL=postgresql://user:password@host:5432/muzflowers
# Для PostgreSQL из compose.yaml. Пароль должен быть длинным и URL-безопасным: буквы, цифры, - и _.
# POSTGRES_DB=muzflowers
# POSTGRES_USER=muzflowers
# POSTGRES_PASSWORD=
# Общий Redis для лимитов между процессами. compose.yaml задаёт адрес автоматически.
# DJANGO_REDIS_URL=redis://127.0.0.1:6379/1

# ───── Связь сайта с Telegram-ботом ─────
# Независимый длинный секрет (не BOT_TOKEN и не пароль базы): минимум 32 случайных символа.
# На своём компьютере можно оставить пустым; на публичном сервере заполнение обязательно.
# BOT_API_SECRET=
# Telegram ID сотрудников, которым разрешены действия с заказами через API:
# BOT_ADMIN_IDS=123456789,987654321

# ───── Уведомления о новых заказах (необязательно) ─────
# Telegram: создайте бота у @BotFather, впишите его ключ, а номер чата узнайте командой
#   python manage.py telegram_setup      (подробно — в README)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Почта сотрудников, куда присылать новые заказы (через запятую):
# ORDER_NOTIFY_EMAILS=owner@example.com
# Любой другой сервис, который принимает данные заказа (адрес вебхука):
# ORDER_WEBHOOK_URL=

# ───── Почта (письма клиентам о заказе, сброс пароля) ─────
# Без этого письма просто печатаются в окне запуска и никуда не уходят.
# DJANGO_EMAIL_HOST=smtp.yandex.ru
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=shop@muzflowers.ru
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_FROM=MuzFlowers <shop@muzflowers.ru>

# ───── Онлайн-оплата (необязательно): tbank или yookassa ─────
# Пока не заполнено, предоплату принимают переводом (реквизиты — в панели) или по ссылке вручную.
# PAYMENT_PROVIDER=tbank
# Т-Касса (Т-Банк): терминал и пароль из личного кабинета
# PAYMENT_TBANK_TERMINAL=
# PAYMENT_TBANK_PASSWORD=
# ЮKassa: номер магазина и секретный ключ
# PAYMENT_YOOKASSA_SHOP_ID=
# PAYMENT_YOOKASSA_SECRET=
# Передавать банку данные для чека (нужно, если подключена онлайн-касса банка). 0 — выключить:
# PAYMENT_RECEIPT=1
# Система налогообложения для чека: usn_income, usn_income_outcome, osn, patent, esn
# PAYMENT_TAXATION=usn_income
# НДС в чеке: none (без НДС), vat0, vat10, vat20
# PAYMENT_VAT=none
